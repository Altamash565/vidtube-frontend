# ======================
#  DEPENDENCIES
# ======================
# Never push installed packages — they're recreated via `bun install`
node_modules/

# ======================
#  BUILD OUTPUT
# ======================
# Generated when you run `bun run build` — deploy this, don't commit it
dist/
dist-ssr/

# ======================
#  ENVIRONMENT FILES
# ======================
# These hold secrets like API keys, DB passwords, JWT secrets, etc.
# RULE: .env files should NEVER reach GitHub. Ever.
# The wildcard .env* catches every variant — .env.local, .env.production, .env.staging, etc.
.env*

# This one is safe — it's a template with placeholder values for new devs
!.env.example

# ======================
#  SECRETS & CREDENTIALS
# ======================
# Private keys (SSH, SSL, encryption)
*.pem
*.key
*.p12
*.pfx

# Cloud provider credentials
.aws/
.gcloud/

# Secret config files
secrets.json
credentials.json

# ======================
#  LOGS
# ======================
# Debug and error logs generated by Node, Bun, or package managers
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ======================
#  EDITOR & IDE FILES
# ======================
# Personal editor settings — each dev has their own preferences
.vscode/
.idea/
*.suo
*.sw?
*.sublime-workspace

# ======================
#  OPERATING SYSTEM FILES
# ======================
# macOS creates these hidden files in every folder
.DS_Store

# Windows creates these thumbnail cache files
Thumbs.db
desktop.ini

# ======================
#  CACHE & TEMP FILES
# ======================
# Package manager & tooling caches — auto-generated, never needed in repo
.bun/
.eslintcache
*.tsbuildinfo

# ======================
#  TESTING & COVERAGE
# ======================
# Generated by test runners (Vitest, Jest, Cypress, Playwright)
coverage/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
